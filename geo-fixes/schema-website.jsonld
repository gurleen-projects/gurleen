{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "iApp Technologies LLP",
  "url": "https://iapptechnologies.com",
  "description": "iApp Technologies LLP — Mobile app development, web platforms, and AI-powered digital products since 2012.",
  "publisher": {
    "@type": "Organization",
    "name": "iApp Technologies LLP"
  },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://iapptechnologies.com/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
